# Configuración del Backend
# En desarrollo (npm run dev): usa localhost
# En producción (npm run build): usa apisye.mobilsoft.co

# URL del backend en desarrollo (localhost)
VITE_API_BASE_URL_DEV=http://localhost:3020

# URL del backend en producción
VITE_API_BASE_URL_PROD=https://apisye.mobilsoft.co

# Puerto del servidor de desarrollo de Vite (opcional, por defecto 5173)
VITE_PORT=5173
